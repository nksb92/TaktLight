{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/OpenLightingProject/open-fixture-library/master/schemas/channel.json",
  "type": "object",
  "properties": {
    "defaultValue": {
      "oneOf": [
        { "$ref": "definitions.json#/definitions/dmxValue" },
        { "type": "string" }
      ]
    },
    "highlightValue": {
      "oneOf": [
        { "$ref": "definitions.json#/definitions/dmxValue" },
        { "type": "string" }
      ]
    },
    "fineChannelAliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "definitions.json#/definitions/nonEmptyString"
      }
    },
    "precedence": {
      "type": "string",
      "enum": ["LTP", "HTP"]
    },
    "capability": {
      "$ref": "capability.json#"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "capability.json#" },
          { "required": ["dmxRange"] }
        ]
      }
    }
  },
  "oneOf": [
    { "required": ["capability"] },
    { "required": ["capabilities"] }
  ]
}
