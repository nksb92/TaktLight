{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaktLight",
  "version": "0.1.0",
  "identifier": "de.anothergermanengineer.taktlight",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TaktLight Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#0A0F18",
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "splashscreen",
        "title": "TaktLight",
        "url": "/splashscreen.html",
        "width": 460,
        "height": 280,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "backgroundColor": "#0A0F18"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
